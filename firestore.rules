rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Open sign-up: any signed-in Google account gets a tracker, but only ever its own.
    // The uid check on `read` is what keeps one athlete's log (and bodyweight, and FCM
    // tokens) out of every other athlete's hands — without it, "signed in" would mean
    // "can read everyone". The reminder sender uses a service account and bypasses these
    // rules, so it still sees every user.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
