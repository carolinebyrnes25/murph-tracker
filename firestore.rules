rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null
        && request.auth.token.email in ['carolinebyrnes25@gmail.com', 'luke.f.byrnes@gmail.com'];
    }
    match /users/{uid} {
      allow read:  if allowed();                            // either allowlisted user can read both logs (partner view)
      allow write: if allowed() && request.auth.uid == uid; // but can only write their own doc
    }
  }
}
